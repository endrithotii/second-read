{"_id": "15118125|None", "id": "15118125", "infons": {}, "passages": [{"infons": {"journal": "Science. 2004 Jun 4;304(5676):1497-500. doi: 10.1126/science.1099314. Epub 2004 ", "year": "2004", "type": "title", "authors": "Paez JG, Janne PA, Lee JC, Tracy S, Greulich H, Gabriel S, Herman P, Kaye FJ, Lindeman N, Boggon TJ, Naoki K, Sasaki H, Fujii Y, Eck MJ, Sellers WR, Johnson BE, Meyerson M"}, "offset": 0, "text": "EGFR mutations in lung cancer: correlation with clinical response to gefitinib therapy.", "sentences": [], "annotations": [{"id": "3", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "EGFR", "locations": [{"offset": 0, "length": 4}]}, {"id": "4", "infons": {"identifier": "MESH:D008175", "type": "Disease", "valid": true, "normalized": ["D008175"], "database": "ncbi_mesh", "normalized_id": "D008175", "biotype": "disease", "name": "Lung Neoplasms", "accession": "@DISEASE_Lung_Neoplasms"}, "text": "lung cancer", "locations": [{"offset": 18, "length": 11}]}, {"id": "5", "infons": {"identifier": "MESH:D000077156", "type": "Chemical", "valid": true, "normalized": ["D000077156"], "database": "ncbi_mesh", "normalized_id": "D000077156", "biotype": "chemical", "name": "Gefitinib", "accession": "@CHEMICAL_Gefitinib"}, "text": "gefitinib", "locations": [{"offset": 69, "length": 9}]}], "relations": []}, {"infons": {"type": "abstract"}, "offset": 88, "text": "Receptor tyrosine kinase genes were sequenced in non-small cell lung cancer (NSCLC) and matched normal tissue. Somatic mutations of the epidermal growth factor receptor gene EGFR were found in 15of 58 unselected tumors from Japan and 1 of 61 from the United States. Treatment with the EGFR kinase inhibitor gefitinib (Iressa) causes tumor regression in some patients with NSCLC, more frequently in Japan. EGFR mutations were found in additional lung cancer samples from U.S. patients who responded to gefitinib therapy and in a lung adenocarcinoma cell line that was hypersensitive to growth inhibition by gefitinib, but not in gefitinib-insensitive tumors or cell lines. These results suggest that EGFR mutations may predict sensitivity to gefitinib.", "sentences": [], "annotations": [{"id": "27", "infons": {"identifier": "MESH:D002289", "type": "Disease", "valid": true, "normalized": ["D002289"], "database": "ncbi_mesh", "normalized_id": "D002289", "biotype": "disease", "name": "Carcinoma Non-Small-Cell Lung", "accession": "@DISEASE_Carcinoma_Non_Small_Cell_Lung"}, "text": "non-small cell lung cancer", "locations": [{"offset": 137, "length": 26}]}, {"id": "28", "infons": {"identifier": "MESH:D002289", "type": "Disease", "valid": true, "normalized": ["D002289"], "database": "ncbi_mesh", "normalized_id": "D002289", "biotype": "disease", "name": "Carcinoma Non-Small-Cell Lung", "accession": "@DISEASE_Carcinoma_Non_Small_Cell_Lung"}, "text": "NSCLC", "locations": [{"offset": 165, "length": 5}]}, {"id": "29", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "epidermal growth factor receptor", "locations": [{"offset": 224, "length": 32}]}, {"id": "30", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "EGFR", "locations": [{"offset": 262, "length": 4}]}, {"id": "31", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh", "normalized_id": "D009369", "biotype": "disease", "name": "Neoplasms", "accession": "@DISEASE_Neoplasms"}, "text": "tumors", "locations": [{"offset": 300, "len