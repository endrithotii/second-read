{"_id": "35245845|None", "id": "35245845", "infons": {}, "passages": [{"infons": {"journal": "Lung Cancer. 2022 Apr;166:94-97. doi: 10.1016/j.lungcan.2022.02.006. Epub 2022 ", "year": "2022", "type": "title", "authors": "Copia Sperandio R, Luiza Teixeira Tostes F, Vidal Campregher P, Ribeiro Paes V, Moura F, Schvartsman G"}, "offset": 0, "text": "EGFR-RAD51 fusion in lung adenocarcinoma with systemic and intracranial response to osimertinib: A case report and review of the literature.", "sentences": [], "annotations": [{"id": "4", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "EGFR", "locations": [{"offset": 0, "length": 4}]}, {"id": "5", "infons": {"identifier": "5888", "type": "Gene", "ncbi_homologene": "2155", "valid": true, "normalized": [5888], "database": "ncbi_gene", "normalized_id": 5888, "biotype": "gene", "name": "RAD51", "accession": "@GENE_RAD51"}, "text": "RAD51", "locations": [{"offset": 5, "length": 5}]}, {"id": "6", "infons": {"identifier": "MESH:D000077192", "type": "Disease", "valid": true, "normalized": ["D000077192"], "database": "ncbi_mesh", "normalized_id": "D000077192", "biotype": "disease", "name": "Adenocarcinoma of Lung", "accession": "@DISEASE_Adenocarcinoma_of_Lung"}, "text": "lung adenocarcinoma", "locations": [{"offset": 21, "length": 19}]}, {"id": "7", "infons": {"identifier": "MESH:C000596361", "type": "Chemical", "valid": true, "normalized": ["C000596361"], "database": "ncbi_mesh", "normalized_id": "C000596361", "biotype": "chemical", "name": "osimertinib", "accession": "@CHEMICAL_osimertinib"}, "text": "osimertinib", "locations": [{"offset": 84, "length": 11}]}], "relations": []}, {"infons": {"type": "abstract"}, "offset": 141, "text": "Comprehensive next-generation sequencing panels are leading to detection of rare gene fusion events. EFGR-RAD51 fusion is a rare oncogenic finding and clinical data for management of this condition is scarce. We report a widely metastatic non-small cell lung cancer in a never-smoker young male patient with sustained near-complete systemic and intracranial response to osimertinib, a third-generation EGFR tyrosine-kinase inhibitor (TKI). We also review the available data of other TKIs in this scenario and underscore the role of comprehensive molecular testing for NSCLC.", "sentences": [], "annotations": [{"id": "13", "infons": {"identifier": "5888", "type": "Gene", "ncbi_homologene": "2155", "valid": true, "normalized": [5888], "database": "ncbi_gene", "normalized_id": 5888, "biotype": "gene", "name": "RAD51", "accession": "@GENE_RAD51"}, "text": "RAD51", "locations": [{"offset": 247, "length": 5}]}, {"id": "14", "infons": {"identifier": "MESH:D002289", "type": "Disease", "valid": true, "normalized": ["D002289"], "database": "ncbi_mesh", "normalized_id": "D002289", "biotype": "disease", "name": "Carcinoma Non-Small-Cell Lung", "accession": "@DISEASE_Carcinoma_Non_Small_Cell_Lung"}, "text": "non-small cell lung cancer", "locations": [{"offset": 380, "length": 26}]}, {"id": "15", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patient", "locations": [{"offset": 436, "length": 7}]}, {"id": "16", "infons": {"identifier": "MESH:C000596361", "type": "Chemical", "valid": true, "normalized": ["C000596361"], "database": "ncbi_mesh", "normalized_id": "C000596361", "biotype": "chemical", "name": "osimertinib", "accession": "@CHEMICAL_osimertinib"}, "text": "osimertinib", "locations": [{"offset": 511, "length": 11}]}, {"id": "17", "infons": {"type": "Disease", "valid": false, "normalized_id": null, "biotype": "disease"}, "text": "NSCLC", "locations": [{"offset": 709, "length": 5}]}], "relations": []}], "relations": [{"id": "R1", "info