{"_id": "26729184|None", "id": "26729184", "infons": {}, "passages": [{"infons": {"journal": "Drugs. 2016 Feb;76(2):263-73. doi: 10.1007/s40265-015-0533-4.", "year": "2016", "type": "title", "authors": "Greig SL"}, "offset": 0, "text": "Osimertinib: First Global Approval.", "sentences": [], "annotations": [{"id": "1", "infons": {"identifier": "MESH:C000596361", "type": "Chemical", "valid": true, "normalized": ["C000596361"], "database": "ncbi_mesh", "normalized_id": "C000596361", "biotype": "chemical", "name": "osimertinib", "accession": "@CHEMICAL_osimertinib"}, "text": "Osimertinib", "locations": [{"offset": 0, "length": 11}]}], "relations": []}, {"infons": {"type": "abstract"}, "offset": 36, "text": "Osimertinib (Tagrisso( ), AZD9291) is an oral, third-generation epidermal growth factor receptor tyrosine kinase inhibitor (EGFR TKI) that is being developed by AstraZeneca for the treatment of advanced non-small cell lung cancer (NSCLC). Osimertinib has been designed to target the EGFR T790M mutation that is often present in NSCLC patients with acquired EGFR TKI resistance, while sparing wild-type EGFR. In November 2015, the tablet formulation of osimertinib was granted accelerated approval in the USA for the treatment of patients with metastatic EGFR T790M mutation-positive NSCLC (as detected by an FDA-approved test) who have progressed on or after EGFR TKI therapy. Osimertinib has also been granted accelerated assessment status for this indication in the EU, and is in phase III development for first- and second-line and adjuvant treatment of advanced EGFR mutation-positive NSCLC in several countries. Phase I trials in patients with advanced solid tumours are also being conducted. This article summarizes the milestones in the development of osimertinib leading to this first approval for NSCLC. ", "sentences": [], "annotations": [{"id": "28", "infons": {"identifier": "MESH:C000596361", "type": "Chemical", "valid": true, "normalized": ["C000596361"], "database": "ncbi_mesh", "normalized_id": "C000596361", "biotype": "chemical", "name": "osimertinib", "accession": "@CHEMICAL_osimertinib"}, "text": "Osimertinib", "locations": [{"offset": 36, "length": 11}]}, {"id": "29", "infons": {"identifier": "MESH:C000596361", "type": "Chemical", "valid": true, "normalized": ["C000596361"], "database": "ncbi_mesh", "normalized_id": "C000596361", "biotype": "chemical", "name": "osimertinib", "accession": "@CHEMICAL_osimertinib"}, "text": "Tagrisso", "locations": [{"offset": 49, "length": 8}]}, {"id": "30", "infons": {"identifier": "MESH:C000596361", "type": "Chemical", "valid": true, "normalized": ["C000596361"], "database": "ncbi_mesh", "normalized_id": "C000596361", "biotype": "chemical", "name": "osimertinib", "accession": "@CHEMICAL_osimertinib"}, "text": "AZD9291", "locations": [{"offset": 62, "length": 7}]}, {"id": "31", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "EGFR", "locations": [{"offset": 160, "length": 4}]}, {"id": "32", "infons": {"identifier": "MESH:D002289", "type": "Disease", "valid": true, "normalized": ["D002289"], "database": "ncbi_mesh", "normalized_id": "D002289", "biotype": "disease", "name": "Carcinoma Non-Small-Cell Lung", "accession": "@DISEASE_Carcinoma_Non_Small_Cell_Lung"}, "text": "non-small cell lung cancer", "locations": [{"offset": 239, "length": 26}]}, {"id": "33", "infons": {"identifier": "MESH:D002289", "type": "Disease", "valid": true, "normalized": ["D002289"], "database": "ncbi_mesh", "normalized_id": "D002289", "biotype": "disease", "name": "Carcinoma Non-Small-Cell Lung", "accession": "@DISEASE_Carcinoma_Non_Small_Cell_Lung"}, "text": "NSCLC", "locations": [{"offset": 267, "length": 5}]}, {"id": "34", "infons": {"identifier": "MESH:C000596361", "type": "Chemical", "valid": true, "normalized": ["C000596361"], "databa