{"_id": "28874593|None", "id": "28874593", "infons": {}, "passages": [{"infons": {"journal": "J Natl Compr Canc Netw. 2017 Sep;15(9):1085-1089. doi: 10.6004/jnccn.2017.0151.", "year": "2017", "type": "title", "authors": "Cecchini M, Sklar J, Lacy J"}, "offset": 0, "text": "EGFR Exon 19 Deletion in Pancreatic Adenocarcinoma Responds to Erlotinib, Followed by T790M-Mediated Resistance.", "sentences": [], "annotations": [{"id": "4", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "EGFR", "locations": [{"offset": 0, "length": 4}]}, {"id": "5", "infons": {"identifier": "MESH:D010190", "type": "Disease", "valid": true, "normalized": ["D010190"], "database": "ncbi_mesh", "normalized_id": "D010190", "biotype": "disease", "name": "Pancreatic Neoplasms", "accession": "@DISEASE_Pancreatic_Neoplasms"}, "text": "Pancreatic Adenocarcinoma", "locations": [{"offset": 25, "length": 25}]}, {"id": "6", "infons": {"identifier": "MESH:D000069347", "type": "Chemical", "valid": true, "normalized": ["D000069347"], "database": "ncbi_mesh", "normalized_id": "D000069347", "biotype": "chemical", "name": "Erlotinib Hydrochloride", "accession": "@CHEMICAL_Erlotinib_Hydrochloride"}, "text": "Erlotinib", "locations": [{"offset": 63, "length": 9}]}, {"id": "7", "infons": {"identifier": "tmVar:p|SUB|T|790|M;HGVS:p.T790M;VariantGroup:0;CorrespondingGene:1956;RS#:121434569;CorrespondingSpecies:9606;CA#:90928", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.T790M", "gene_ids": [1956], "gene_id": 1956, "rsids": ["rs121434569"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA90928", "rsid": "rs121434569", "normalized": ["rs121434569##", "#1956#", "CA90928#rs121434569##"], "normalized_id": "rs121434569##", "biotype": "variant", "name": "p.T790M", "accession": "@VARIANT_p.T790M_EGFR_human"}, "text": "T790M", "locations": [{"offset": 86, "length": 5}]}], "relations": []}, {"infons": {"type": "abstract"}, "offset": 113, "text": "The prognosis of metastatic pancreatic cancer remains poor despite recent advances in treatment with multidrug chemotherapy regimens. Use of immune checkpoint inhibitors and molecular targeted therapies has so far been disappointing. This report describes a patient with chemotherapy-refractory metastatic pancreatic ductal adenocarcinoma (PDAC) whose tumor was characterized by an activating mutation in exon 19 of the epidermal growth factor receptor (EGFR). He experienced response to erlotinib for 10 months, and then developed disease progression in association with emergence of the T790M mutation. Activating EGFR mutations in cancers other than lung are uncommon, but when present may predict response to EGFR tyrosine kinase inhibitors (TKIs). Development of the T790M mutation in this case suggests that EGFR-targeted TKIs may follow similar patterns of resistance regardless of tumor type. Although actionable mutations are detected infrequently in PDAC, this case illustrates the potential benefit of offering genomic analysis to all patients with advanced disease.", "sentences": [], "annotations": [{"id": "25", "infons": {"identifier": "MESH:D010190", "type": "Disease", "valid": true, "normalized": ["D010190"], "database": "ncbi_mesh", "normalized_id": "D010190", "biotype": "disease", "name": "Pancreatic Neoplasms", "accession": "@DISEASE_Pancreatic_Neoplasms"}, "text": "pancreatic cancer", "locations": [{"offset": 141, "length": 17}]}, {"id": "26", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patient", "locations": [{"offset": 371, "length": 7}]}, {"id": "27", "infons": {"identifier": "MESH:D021441", "type": "Disease", "valid": true, "normaliz