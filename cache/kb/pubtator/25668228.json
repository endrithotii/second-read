{"_id": "25668228|None", "id": "25668228", "infons": {}, "passages": [{"infons": {"journal": "Clin Chim Acta. 2015 Apr 15;444:81-5. doi: 10.1016/j.cca.2015.01.039. Epub 2015 ", "year": "2015", "type": "title", "authors": "Denis MG, Vallee A, Theoleyre S"}, "offset": 0, "text": "EGFR T790M resistance mutation in non small-cell lung carcinoma.", "sentences": [], "annotations": [{"id": "3", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "EGFR", "locations": [{"offset": 0, "length": 4}]}, {"id": "4", "infons": {"identifier": "tmVar:p|SUB|T|790|M;HGVS:p.T790M;VariantGroup:0;CorrespondingGene:1956;RS#:121434569;CorrespondingSpecies:9606;CA#:90928", "type": "Variant", "valid": true, "subtype": "ProteinMutation", "database": "litvar", "hgvs": "p.T790M", "gene_ids": [1956], "gene_id": 1956, "rsids": ["rs121434569"], "species_ids": [9606], "species_id": 9606, "clingen_id": "CA90928", "rsid": "rs121434569", "normalized": ["rs121434569##", "#1956#", "CA90928#rs121434569##"], "normalized_id": "rs121434569##", "biotype": "variant", "name": "p.T790M", "accession": "@VARIANT_p.T790M_EGFR_human"}, "text": "T790M", "locations": [{"offset": 5, "length": 5}]}, {"id": "5", "infons": {"identifier": "MESH:D002289", "type": "Disease", "valid": true, "normalized": ["D002289"], "database": "ncbi_mesh", "normalized_id": "D002289", "biotype": "disease", "name": "Carcinoma Non-Small-Cell Lung", "accession": "@DISEASE_Carcinoma_Non_Small_Cell_Lung"}, "text": "non small-cell lung carcinoma", "locations": [{"offset": 34, "length": 29}]}], "relations": []}, {"infons": {"type": "abstract"}, "offset": 65, "text": "Lung cancer patients carrying sensitive epidermal growth factor receptor (EGFR) mutations show dramatic responses to tyrosine kinase inhibitors (TKIs). However, the majority of patients whose disease responds to drugs eventually develop resistance to these EGFR-TKIs. The T790M gatekeeper mutation in the EGFR tyrosine kinase domain accounts for half of resistance to these drugs. In some patients, this mutation is also detected as a primary event before drug exposure, at a frequency that is highly dependent on the technique used. This review will focus on the methods that have been used to detect the T790M mutation, and its potential clinical applications both in TKI naive patients and in patients with an acquired resistance. ", "sentences": [], "annotations": [{"id": "18", "infons": {"identifier": "MESH:D008175", "type": "Disease", "valid": true, "normalized": ["D008175"], "database": "ncbi_mesh", "normalized_id": "D008175", "biotype": "disease", "name": "Lung Neoplasms", "accession": "@DISEASE_Lung_Neoplasms"}, "text": "Lung cancer", "locations": [{"offset": 65, "length": 11}]}, {"id": "19", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": null}, "text": "patients", "locations": [{"offset": 77, "length": 8}]}, {"id": "20", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "epidermal growth factor receptor", "locations": [{"offset": 105, "length": 32}]}, {"id": "21", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "EGFR", "locations": [{"offset": 139, "length": 4}]}, {"id": "22", "infons": {"identifier": "9606", "type": "Species", "valid": true, "normalized": [9606], "database": "ncbi_taxonomy", "normalized_id": 9606, "biotype": "species", "name": "9606", "accession": 