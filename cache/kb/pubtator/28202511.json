{"_id": "28202511|None", "id": "28202511", "infons": {}, "passages": [{"infons": {"journal": "Cancer Res. 2017 Apr 15;77(8):2078-2089. doi: 10.1158/0008-5472.CAN-16-2359. Epub ", "year": "2017", "type": "title", "authors": "Nukaga S, Yasuda H, Tsuchihara K, Hamamoto J, Masuzawa K, Kawada I, Naoki K, Matsumoto S, Mimaki S, Ikemura S, Goto K, Betsuyaku T, Soejima K"}, "offset": 0, "text": "Amplification of EGFR Wild-Type Alleles in Non-Small Cell Lung Cancer Cells Confers Acquired Resistance to Mutation-Selective EGFR Tyrosine Kinase Inhibitors.", "sentences": [], "annotations": [{"id": "3", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "EGFR", "locations": [{"offset": 17, "length": 4}]}, {"id": "4", "infons": {"identifier": "MESH:D002289", "type": "Disease", "valid": true, "normalized": ["D002289"], "database": "ncbi_mesh", "normalized_id": "D002289", "biotype": "disease", "name": "Carcinoma Non-Small-Cell Lung", "accession": "@DISEASE_Carcinoma_Non_Small_Cell_Lung"}, "text": "Non-Small Cell Lung Cancer", "locations": [{"offset": 43, "length": 26}]}, {"id": "5", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "EGFR", "locations": [{"offset": 126, "length": 4}]}], "relations": []}, {"infons": {"type": "abstract"}, "offset": 159, "text": "EGFR-mutated lung cancers account for a significant subgroup of non-small cell lung cancers overall. Third-generation EGFR tyrosine kinase inhibitors (TKI) are mutation-selective inhibitors with minimal effects on wild-type EGFR. Acquired resistance develops to these agents, however, the mechanisms are as yet uncharacterized. In this study, we report that the Src-AKT pathway contributes to acquired resistance to these TKI. In addition, amplification of EGFR wild-type alleles but not mutant alleles was sufficient to confer acquired resistance. These findings underscore the importance of signals from wild-type EGFR alleles in acquiring resistance to mutant-selective EGFR-TKI. Our data provide evidence of wild-type allele-mediated resistance, a novel concept of acquired resistance in response to mutation-selective inhibitor therapy in cancer treatment. Cancer Res; 77(8); 2078-89.  2017 AACR.", "sentences": [], "annotations": [{"id": "18", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "EGFR", "locations": [{"offset": 159, "length": 4}]}, {"id": "19", "infons": {"identifier": "MESH:D008175", "type": "Disease", "valid": true, "normalized": ["D008175"], "database": "ncbi_mesh", "normalized_id": "D008175", "biotype": "disease", "name": "Lung Neoplasms", "accession": "@DISEASE_Lung_Neoplasms"}, "text": "lung cancers", "locations": [{"offset": 172, "length": 12}]}, {"id": "20", "infons": {"identifier": "MESH:D002289", "type": "Disease", "valid": true, "normalized": ["D002289"], "database": "ncbi_mesh", "normalized_id": "D002289", "biotype": "disease", "name": "Carcinoma Non-Small-Cell Lung", "accession": "@DISEASE_Carcinoma_Non_Small_Cell_Lung"}, "text": "non-small cell lung cancers", "locations": [{"offset": 223, "length": 27}]}, {"id": "21", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "EGFR", "locations": [{"offset": 277, "length": 4}]}, {"id": "22", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "databa