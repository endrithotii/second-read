{"_id": "18089823|None", "id": "18089823", "infons": {}, "passages": [{"infons": {"journal": "Cancer Res. 2007 Dec 15;67(24):11924-32. doi: 10.1158/0008-5472.CAN-07-1885.", "year": "2007", "type": "title", "authors": "Engelman JA, Zejnullahu K, Gale CM, Lifshits E, Gonzales AJ, Shimamura T, Zhao F, Vincent PW, Naumov GN, Bradner JE, Althaus IW, Gandhi L, Shapiro GI, Nelson JM, Heymach JV, Meyerson M, Wong KK, Janne PA"}, "offset": 0, "text": "PF00299804, an irreversible pan-ERBB inhibitor, is effective in lung cancer models with EGFR and ERBB2 mutations that are resistant to gefitinib.", "sentences": [], "annotations": [{"id": "6", "infons": {"identifier": "MESH:C525726", "type": "Chemical", "valid": true, "normalized": ["C525726"], "database": "ncbi_mesh", "normalized_id": "C525726", "biotype": "chemical", "name": "dacomitinib", "accession": "@CHEMICAL_dacomitinib"}, "text": "PF00299804", "locations": [{"offset": 0, "length": 10}]}, {"id": "7", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "ERBB", "locations": [{"offset": 32, "length": 4}]}, {"id": "8", "infons": {"identifier": "MESH:D008175", "type": "Disease", "valid": true, "normalized": ["D008175"], "database": "ncbi_mesh", "normalized_id": "D008175", "biotype": "disease", "name": "Lung Neoplasms", "accession": "@DISEASE_Lung_Neoplasms"}, "text": "lung cancer", "locations": [{"offset": 64, "length": 11}]}, {"id": "9", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "EGFR", "locations": [{"offset": 88, "length": 4}]}, {"id": "10", "infons": {"identifier": "2064", "type": "Gene", "ncbi_homologene": "3273", "valid": true, "normalized": [2064], "database": "ncbi_gene", "normalized_id": 2064, "biotype": "gene", "name": "ERBB2", "accession": "@GENE_ERBB2"}, "text": "ERBB2", "locations": [{"offset": 97, "length": 5}]}, {"id": "11", "infons": {"identifier": "MESH:D000077156", "type": "Chemical", "valid": true, "normalized": ["D000077156"], "database": "ncbi_mesh", "normalized_id": "D000077156", "biotype": "chemical", "name": "Gefitinib", "accession": "@CHEMICAL_Gefitinib"}, "text": "gefitinib", "locations": [{"offset": 135, "length": 9}]}], "relations": []}, {"infons": {"type": "abstract"}, "offset": 146, "text": "Epidermal growth factor receptor (EGFR) tyrosine kinase inhibitors gefitinib and erlotinib are effective treatments for a subset of non-small cell lung cancers. In particular, cancers with specific EGFR-activating mutations seem to be the most sensitive to these agents. However, despite their initial response, such cancers almost invariably develop resistance. In 50% of such cancers, a secondary EGFR mutation, T790M, has been identified that renders gefitinib and erlotinib ineffective inhibitors of EGFR kinase activity. Thus, there is a clinical need to develop novel EGFR inhibitors that can effectively inactivate T790M-containing EGFR proteins. In this study, we evaluate the effectiveness of a novel compound, PF00299804, an irreversible pan-ERBB inhibitor. The results from these studies show that PF00299804 is a potent inhibitor of EGFR-activating mutations as well as the EGFR T790M resistance mutation both in vitro and in vivo. Additionally, PF00299804 is a highly effective inhibitor of both the wild-type ERBB2 and the gefitinib-resistant oncogenic ERBB2 mutation identified in lung cancers. These preclinical evaluations support further clinical development of PF00299804 for cancers with mutations and/or amplifications of ERBB family members.", "sentences": [], "annotations": [{"id": "44", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "Epidermal growth factor receptor", "locations": [{"offset": 146, "length": 32}]}, {"id": "45", "infons": {"identifier": "1956", "type": "Gene", "ncbi_homologene": "74545", "valid": true, "normalized": [1956], "database": "ncbi_gene", "normalized_id": 1956, "biotype": "gene", "name": "EGFR", "accession": "@GENE_EGFR"}, "text": "EGFR", "locations": [{"offset": 180, "length": 4}]}, {"id": "46", "infons": {"identifier": "7294", "type": "Gene", "ncbi_homologene": "2497", "valid": true, "normalized": [7294], "database": "ncbi_gene", "normalized_id": 7294, "biotype": "gene", "name": "TXK", "accession": "@GENE_TXK"}, "text": "tyrosine kinase", "locations": [{"offset": 186, "length": 15}]}, {"id": "47", "infons": {"identifier": "MESH:D000077156", "type": "Chemical", "valid": true, "normalized": ["D000077156"], "database": "ncbi_mesh", "normalized_id": "D000077156", "biotype": "chemical", "name": "Gefitinib", "accession": "@CHEMICAL_Gefitinib"}, "text": "gefitinib", "locations": [{"offset": 213, "length": 9}]}, {"id": "48", "infons": {"identifier": "MESH:D000069347", "type": "Chemical", "valid": true, "normalized": ["D000069347"], "database": "ncbi_mesh", "normalized_id": "D000069347", "biotype": "chemical", "name": "Erlotinib Hydrochloride", "accession": "@CHEMICAL_Erlotinib_Hydrochloride"}, "text": "erlotinib", "locations": [{"offset": 227, "length": 9}]}, {"id": "49", "infons": {"identifier": "MESH:D002289", "type": "Disease", "valid": true, "normalized": ["D002289"], "database": "ncbi_mesh", "normalized_id": "D002289", "biotype": "disease", "name": "Carcinoma Non-Small-Cell Lung", "accession": "@DISEASE_Carcinoma_Non_Small_Cell_Lung"}, "text": "non-small cell lung cancers", "locations": [{"offset": 278, "length": 27}]}, {"id": "50", "infons": {"identifier": "MESH:D009369", "type": "Disease", "valid": true, "normalized": ["D009369"], "database": "ncbi_mesh"